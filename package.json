{
  "name": "rate-limiter",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "typecheck": "tsc --noEmit",
    "start:admin": "bun run src/index.ts",
    "dev:admin": "bun run --watch --no-clear src/index.ts",
    "start:traffic": "bun run src/entry-traffic.ts",
    "dev:traffic": "bun --no-clear-screen --watch src/entry-traffic.ts",
    "dev:consumers": "bun --no-clear-screen --watch src/jobs/index.ts",
    "prepare": "husky",
    "db:migrate": "drizzle-kit migrate",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "bun run src/seed.ts",
    "db:seed:clean": "bun run src/seed.ts --clean",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "NODE_OPTIONS='--experimental-vm-modules' jest --watch",
    "test:coverage": "NODE_OPTIONS='--experimental-vm-modules' jest --coverage"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.1",
    "@commitlint/config-conventional": "^20.4.1",
    "@types/bun": "latest",
    "@types/jest": "^29.5.0",
    "@types/supertest": "^6.0.0",
    "drizzle-kit": "^0.31.9",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.0"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@fastify/cors": "^11.2.0",
    "@fastify/helmet": "^13.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/swagger": "^9.7.0",
    "@fastify/swagger-ui": "^5.2.5",
    "@types/bcrypt": "^6.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.16.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.78.0",
    "dotenv": "^17.4.2",
    "dotenv-expand": "^13.0.0",
    "drizzle-orm": "^0.45.1",
    "fastify": "^5.7.4",
    "fastify-plugin": "^6.0.0",
    "groq-sdk": "^1.3.0",
    "http-status-codes": "^2.3.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.3",
    "nanoid": "^5.1.11",
    "pg": "^8.18.0",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.9",
    "redis": "^5.10.0",
    "stripe": "^22.2.0",
    "winston": "^3.19.0",
    "zod": "^4.4.3"
  }
}
